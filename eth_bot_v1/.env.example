# ============================================
# NO API KEYS REQUIRED! Using public endpoints
# ============================================

# Trading Settings
SYMBOL=ETH/USDT
TIMEFRAME=1h
INITIAL_CAPITAL=10000
POSITION_SIZE=0.1

# Model Settings
SEQUENCE_LENGTH=24
EPOCHS=50
BATCH_SIZE=32
LEARNING_RATE=0.001

# Scheduler
UPDATE_INTERVAL_MINUTES=60
MODEL_RETRAIN_HOURS=24

# Features
ENABLE_PAPER_TRADING=True
ENABLE_BACKTESTING=True
ENABLE_MODEL_TRAINING=True
ENABLE_DATA_COLLECTION=True
ENABLE_LIVE_TRADING=False

# Logging
LOG_LEVEL=INFO

# ============================================
# OPTIONAL: Add API keys for higher rate limits
# (Not required - bot works without them)
# ============================================
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# COINGECKO_API_KEY=
# ETHERSCAN_API_KEY=